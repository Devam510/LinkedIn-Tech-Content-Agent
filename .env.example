# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose your LLM: "grok" (default) or "gemini"
LLM_PROVIDER=grok

# ── Grok / xAI (https://console.x.ai) ───────────────────────────────────────
GROK_API_KEY=your_grok_api_key_here
GROK_MODEL=grok-2                # or grok-3-mini for cheaper/faster

# ── Gemini (optional — only needed if LLM_PROVIDER=gemini OR for Imagen 3) ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Unsplash (free photos) ───────────────────────────────────────────────────────────
# Register free at https://unsplash.com/developers (takes 2 minutes)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# ── LinkedIn credentials (used for first-time login & Playwright session) ────
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password_here

# ── Reddit (optional – unauthenticated JSON endpoint works without these) ─────
REDDIT_CLIENT_ID=optional_reddit_client_id
REDDIT_CLIENT_SECRET=optional_reddit_client_secret
REDDIT_USER_AGENT=linkedin-agent/1.0

# ── Product Hunt (optional) ──────────────────────────────────────────────────
PRODUCT_HUNT_TOKEN=optional_product_hunt_api_token

# ── Alerts (optional – Slack webhook for failure notifications) ───────────────
SLACK_WEBHOOK_URL=optional_slack_webhook_url

# ── Scheduler ─────────────────────────────────────────────────────────────────
# UTC hour to post (e.g. 3 = 9:00 AM IST / UTC+5:30)
POST_HOUR_UTC=3
